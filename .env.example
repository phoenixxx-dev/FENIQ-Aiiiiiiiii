DATABASE_URL=postgresql+asyncpg://phoenix:phoenix@127.0.0.1:5432/phoenix
REDIS_URL=redis://127.0.0.1:6379/0
# --- التخزين ---
# ملفات المستخدمين تُحفظ هنا، على قرص السيرفر نفسه (قرار المالك، ق-48).
# ⚠️ في الإنتاج: اجعله مساراً على قرص دائم بمساحة كافية، لا داخل /tmp.
# القرص الممتلئ يوقف المنتج كلّه — الرفع يُرفض قبل ذلك برسالة واضحة،
# و/health يعرض disk_free_mb ويتحوّل إلى degraded تحت 2 جيجابايت.
LOCAL_STORAGE_DIR=/root/phoenix-work/storage-dev
JWT_SECRET=change-me

# --- الصيانة ---
# تنظيف سجلات رفع لم يصل محتواها (ساعات)
ABANDONED_UPLOAD_HOURS=24
# سياسة الاحتفاظ بالأيام. 0 = بلا حذف تلقائي (الافتراضي — انظر docs/DECISIONS.md ق-14)
#
# ⚠️ مع التخزين على قرص السيرفر (ق-48) هذه القيمة هي التي تجعل «الضروري
# فقط يبقى» حقيقةً لا نيّة: 0 تعني أن كل ملف رُفع يوماً ما زال يأكل مساحة.
# قيمة معقولة للبداية: 90.
RETENTION_DAYS=0
